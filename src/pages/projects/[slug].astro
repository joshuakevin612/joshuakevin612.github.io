---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: all[(i + 1) % all.length] } }));
}
const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const main = d.shot ?? d.cover;
const ogImg = d.cover ? await getImage({ src: d.cover, width: 1200, format: 'png' }) : undefined;
const og = ogImg?.src;
const site = Astro.site!;
const url = new URL(`/projects/${entry.id}/`, site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': d.repo ? 'SoftwareSourceCode' : 'CreativeWork', name: d.title, description: d.summary, url, ...(d.live && { sameAs: d.live }),
    ...(og && { image: new URL(og, site).href }), dateCreated: String(d.year), author: { '@id': new URL('/about/#person', site).href },
    ...(d.repo && { codeRepository: d.repo }),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: site.href }, { '@type': 'ListItem', position: 2, name: d.title, item: url }],
  },
];
---
<Layout title={`${d.title} — Joshua Kevin`} description={d.summary} theme="dark" image={og} imageSize={ogImg && { width: ogImg.attributes.width, height: ogImg.attributes.height }} imageAlt={`${d.title} cover`} ogType="article" jsonLd={jsonLd}>
  <article class="proj">
    <p class="mono dim" data-reveal><a class="link" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/#work`}>← All work</a></p>
    <h1 class="proj__title" data-proj-title>{d.title}</h1>
    <p class="proj__summary" data-reveal>{d.summary}</p>
    <div class="proj__cover" data-parallax>
      {main ? <Image src={main} width={1600} alt={d.shot ? `${d.title} running` : `${d.title} cover`} transition:name={`cover-${entry.id}`} /> : null}
    </div>
    <dl class="facts mono" data-reveal>
      <div><dt>Year</dt><dd>{d.year}</dd></div>
      <div><dt>Role</dt><dd>{d.role}</dd></div>
      <div><dt>Stack</dt><dd>{d.stack.join(', ')}</dd></div>
      {(d.live || d.repo) && (
        <div><dt>Links</dt><dd>
          {d.live && <a class="link" href={d.live} rel="noopener noreferrer">Live ↗</a>}{d.live && d.repo && ' · '}
          {d.repo && <a class="link" href={d.repo} rel="noopener noreferrer">Code ↗</a>}
        </dd></div>
      )}
    </dl>
    <div class="prose" data-prose><Content /></div>
  </article>
  <a class="next" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/projects/${next.id}/`} data-next data-slug={next.id} aria-label={`Next project: ${next.data.title}`}>
    <span class="mono dim">Next project</span>
    <div class="next__title">{next.data.title} →</div>
    {next.data.cover && <div class="next__strip" data-next-strip data-cursor-label="Open"><Image src={next.data.cover} width={1600} alt="" /></div>}
  </a>
  <footer class="foot mono dim"><span>© Joshua Kevin</span><a class="link" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/`}>Home</a></footer>
</Layout>
